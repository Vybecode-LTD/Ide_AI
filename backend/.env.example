# ── Core ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ide_ai:password@localhost:5432/ide_ai_db
ANTHROPIC_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
APP_NAME=Ide/AI
FRONTEND_URL=http://localhost:5173

# ── Clerk Authentication ─────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional JWT hardening (recommended for production):
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]

# ── Stripe Billing ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@send.myide.ai
INBOX_DOMAIN=inbox.myide.ai
RESEND_WEBHOOK_SECRET=whsec_...

# ── Security ─────────────────────────────────────────────────────
# Fernet key for encrypting external integration OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_KEY=

# JWT secret for viewer access tokens on password-protected shares.
# Falls back to CLERK_SECRET_KEY if empty.
SHARE_ACCESS_SECRET=
