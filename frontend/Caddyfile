# Caddyfile — Serves the Vite-built SPA with proper fallback for React Router.
:{$PORT:3000}

root * /srv
file_server

# Compress all responses (zstd preferred, gzip fallback)
encode zstd gzip

# SPA fallback: serve index.html for all non-file routes
try_files {path} /index.html

# Cache hashed static assets aggressively (1 year — content-hash names ensure busting)
@static path *.js *.css *.woff2 *.woff *.png *.svg *.ico
header @static Cache-Control "public, max-age=31536000, immutable"

# Never cache the SPA shell — deploy updates must reach users immediately
@html not path *.js *.css *.woff2 *.woff *.png *.svg *.ico *.xml *.txt
header @html Cache-Control "no-cache, no-store, must-revalidate"

# Preload LCP hero image on the root landing page
@root path /
header @root Link </brandmark.png>; rel=preload; as=image; type="image/png"

# Security + crawl headers
header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    X-Robots-Tag "index, follow"
    # CSP — clerk.myide.ai is the PRODUCTION Clerk Frontend API (custom domain); the live
    # publishable key (pk_live_…) decodes to it, so the browser loads Clerk's SDK from there.
    # It MUST be in script-src / connect-src / img-src / frame-src or Clerk never initializes
    # and the whole SPA hangs on the loading spinner. *.clerk.accounts.dev alone only covers
    # development instances. Do not remove https://clerk.myide.ai.
    # connect-src must list the backend ORIGIN with NO path: a path like /api/v1 makes CSP
    # exact-match the path and BLOCK sub-paths such as /api/v1/auth/me (loads the user +
    # is_admin) — which empties the profile name and hides the Admin link. Origin-only
    # matches all paths. ({$VITE_API_BASE_URL} carries the path and is kept only as a fallback.)
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://clerk.myide.ai https://*.clerk.accounts.dev https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://clerk.myide.ai https://*.clerk.accounts.dev https://img.clerk.com; connect-src 'self' https://clerk.myide.ai https://*.clerk.accounts.dev https://*.google-analytics.com https://challenges.cloudflare.com https://backend-production-9c212.up.railway.app {$VITE_API_BASE_URL:*}; frame-src https://clerk.myide.ai https://*.clerk.accounts.dev https://challenges.cloudflare.com https://js.stripe.com; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
}
