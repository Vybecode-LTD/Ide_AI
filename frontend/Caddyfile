# Caddyfile — Serves the Vite-built SPA with proper fallback for React Router.
:{$PORT:3000}

root * /srv
file_server

# SPA fallback: serve index.html for all non-file routes
try_files {path} /index.html

# Cache static assets aggressively (1 year — hashed filenames ensure cache busting)
@static path *.js *.css *.woff2 *.woff *.png *.svg *.ico
header @static Cache-Control "public, max-age=31536000, immutable"

# Preload LCP hero image on the root landing page
@root path /
header @root Link </brandmark.png>; rel=preload; as=image; type="image/png"

# Security + crawl headers
header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    X-Robots-Tag "index, follow"
}
